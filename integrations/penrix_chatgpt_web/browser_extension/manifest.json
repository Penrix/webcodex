{
  "manifest_version": 3,
  "name": "Penrix WebCodex",
  "version": "0.1.0",
  "description": "Connect this ChatGPT conversation to an explicitly selected local WebCodex project.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["protocol.js", "content.js"],
    "run_at": "document_idle"
  }]
}
